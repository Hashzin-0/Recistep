# Public browser configuration. These values are public and are protected by Auth/RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only credentials; never prefix secrets with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini recipe extraction (server-only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Gemini Live voice agent (server-only; reuses GEMINI_API_KEY)
GEMINI_LIVE_MODEL=gemini-3.8-live-extended-thinking
GEMINI_LIVE_VOICE=Puck
# Minute limit for a single voice session token (1-30, default 30).
GEMINI_LIVE_TOKEN_TTL_MINUTES=30

# Inngest durable workflows
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Set to 1 only for local Inngest Dev Server use.
INNGEST_DEV=0
